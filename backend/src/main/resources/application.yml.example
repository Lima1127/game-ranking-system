spring:
  datasource:
    # Ajuste para o seu PostgreSQL local
    url: jdbc:postgresql://localhost:5432/game_ranking
    username: postgres
    password: sua_senha_aqui
  jpa:
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        format_sql: true
    open-in-view: false
  flyway:
    enabled: true
  servlet:
    multipart:
      max-file-size: 5MB
      max-request-size: 5MB

server:
  port: 8080

app:
  jwt:
    # Obrigatorio: segredo aleatorio com pelo menos 32 bytes (o backend nao sobe sem ele).
    # Gere um com: openssl rand -base64 48   (ou defina a variavel de ambiente APP_JWT_SECRET)
    secret: troque-esta-chave-em-producao
    expiration-seconds: 7200
  storage:
    # disk = arquivos na pasta abaixo (uso local); database = dentro do banco (usado na nuvem)
    type: disk
    root-path: ./storage
  registration:
    # Se preenchido, o cadastro exige este codigo de convite. Vazio = cadastro aberto.
    invite-code: ""
  steam:
    # Sugestoes de jogos da loja Steam no campo "Jogo" (busca publica, sem chave de API).
    # false = desliga; o cadastro de jogos volta a ser so pelo nome digitado.
    enabled: true
    # Chave da Steam Web API (https://steamcommunity.com/dev/apikey), usada para conferir horas e
    # conquistas dos registros. Segredo: nao coloque no Git. Vazio = conferencia desligada.
    # Tambem pode vir da variavel de ambiente STEAM_API_KEY.
    api-key: ""
  # Endereco pelo qual as pessoas abrem o site. A Steam devolve a pessoa para ca depois do
  # login de "Conectar Steam". Localmente e o Vite; por tunel, troque pelo endereco do tunel.
  public-url: http://localhost:5173
