spring:
  datasource:
    # Ajuste para o seu PostgreSQL local
    url: jdbc:postgresql://localhost:5432/game_ranking
    username: postgres
    password: sua_senha_aqui
  jpa:
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        format_sql: true
    open-in-view: false
  flyway:
    enabled: true
  servlet:
    multipart:
      max-file-size: 5MB
      max-request-size: 5MB

server:
  port: 8080

app:
  jwt:
    # Obrigatorio: segredo aleatorio com pelo menos 32 bytes (o backend nao sobe sem ele).
    # Gere um com: openssl rand -base64 48   (ou defina a variavel de ambiente APP_JWT_SECRET)
    secret: troque-esta-chave-em-producao
    expiration-seconds: 7200
  storage:
    # disk = arquivos na pasta abaixo (uso local); database = dentro do banco (usado na nuvem)
    type: disk
    root-path: ./storage
  registration:
    # Se preenchido, o cadastro exige este codigo de convite. Vazio = cadastro aberto.
    invite-code: ""
